# ADVANCED / OPTIONAL -- not needed to run this on your own machine.
#
# These values are only read by tools/deploy.sh, which deploys to a REMOTE
# Docker host over SSH and can give the container its own macvlan address.
# For a laptop, ignore this file entirely and use:  docker compose up -d
#
# One file per board. Copy, edit, then:
#   ./tools/deploy.sh --env instances/<name>.env --rebuild

INSTANCE=jobhunt                              # container name; shown in the UI
JOBHUNT_IP=192.168.1.10                       # its own macvlan address, one per instance
JOBHUNT_DATA_DIR=/srv/appdata/jobhunt    # database, config.yaml, resume
JOBHUNT_HOST=user@your-docker-host
JOBHUNT_NETWORK=br0
JOBHUNT_PROXY_CONTAINER=your-reverse-proxy
JOBHUNT_TZ=Etc/UTC

# Instances share a public IP, so they share a reputation with every source.
# 1.0 is full speed. Set 2.0 on a second instance to halve its request rate.
POLITENESS_SCALE=1.0

# Optional. Unset means LAN-only with no login.
APP_PASSWORD=
API_TOKEN=
